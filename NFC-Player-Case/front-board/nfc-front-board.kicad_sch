	(text "Keys and the knob pull a GPIO pin to ground; the Pi's own pull-ups hold them high."
		(exclude_from_sim no)
		(at 20.32 160.02 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "d65eb297-5045-5e36-8e85-6a9fdf187255")
	)
	(text "The power key reaches GPIO 24 and GPIO 3 through D1 and D2. GPIO 3 is the only pin that wakes a Pi that has shut down."
		(exclude_from_sim no)
		(at 20.32 165.1 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "6ab98ac5-3485-560f-ad27-d066f2cafe80")
	)
	(text "GPIO 22 lights the key's LED through Q1 from 5 V. config.txt switches it on at boot and the shutdown hook switches it off."
		(exclude_from_sim no)
		(at 20.32 170.18 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "c6dce113-ae6e-5d26-b30c-ba411803b54e")
	)
	(text "R2 sets the LED current (about 10-13 mA). If the button's LED has its own resistor (rated 5 V or 6 V), R2 can stay or be bridged."
		(exclude_from_sim no)
		(at 20.32 175.26 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "07d4699e-03f9-599e-a7a0-87ad8ddf19a6")
	)
	(text "J6 is for the 0.91-inch OLED instead of the 2-inch screen. Fit one or the other."
		(exclude_from_sim no)
		(at 20.32 180.34 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "f3c21cbb-929a-5c24-a25b-141d5d62276a")
	)
	(text "D3 and D4 light while the board has 3.3 V and 5 V from the Pi, at about 1 mA each."
		(exclude_from_sim no)
		(at 20.32 185.42 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "cd47f10f-f8b7-5be9-9a7d-d75c9de83f47")
	)
	(text "All the D, R and Q parts are surface-mount, placed by the board maker (LCSC numbers in their LCSC field)."
		(exclude_from_sim no)
		(at 20.32 190.5 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "30e0a57b-f38f-56f8-bc83-e68334292217")
	)
