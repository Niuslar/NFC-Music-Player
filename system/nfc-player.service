[Unit]
Description=NFC album player
# Not After=mpd.service: the player starts alongside MPD so the boot logo shows sooner, and waits for MPD itself.
After=nfc-player-usb.service
Wants=mpd.service nfc-player-usb.service
# Keep trying for ever: it is an appliance, and a new version that keeps failing is rolled back by the hook below.
StartLimitIntervalSec=0

[Service]
User=@USER@
# The program is in /opt/nfc-player/a or /opt/nfc-player/b; current links to the one in use (system/nfc-player-update).
WorkingDirectory=/opt/nfc-player/current
# Runs as root before every start: counts the starts of a newly installed version and goes back to
# the previous one if it keeps failing. "-" so a problem in the hook never keeps the player from starting.
ExecStartPre=-+/usr/local/sbin/nfc-player-update boot
Environment=PYTHONUNBUFFERED=1
# Screen, knob and orientation are set on the web remote's Setup page (/setup).
# Options here (--display, --encoder, --encoder-reverse, --rotate) win over that page.
# --web-port 80 serves the web remote at http://nfcplayer.local ; --web-port 0 turns it off
ExecStart=/usr/bin/python3 -m player.main --music /mnt/music --state /var/lib/nfc-player/state.json --playback mpd --web-port 80
AmbientCapabilities=CAP_NET_BIND_SERVICE
# @USER@ is a system user setup.sh makes, allowed only the helpers in /etc/sudoers.d/nfc-player.
# No ProtectSystem, ProtectHome, PrivateTmp or ReadWritePaths: each gives the service its own view
# of the mounts, and the helpers it runs through sudo would then mount and unmount the music drive
# in that view only, leaving it mounted on the Pi while it is handed to a computer over USB.
# NoNewPrivileges would stop sudo, and so the helpers, altogether.
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
