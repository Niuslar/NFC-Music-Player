#!/bin/sh
# Root helper for Wi-Fi setup, through NetworkManager. Installed to /usr/local/sbin by setup.sh.
#
#   scan          list nearby networks, one "signal:security:name" line each (nmcli -t)
#   hotspot-up    start the player's own setup network; reads its password from stdin
#   hotspot-down  stop it and go back to a saved network, if one is in range
#   join          read a network name, then its password (empty for an open network),
#                 one per line from stdin; join it and save it for next time
#   radio-off     switch Wi-Fi off; NetworkManager keeps it off, even after a restart
#   radio-on      switch it on again; NetworkManager joins a saved network if one is in range
#
# Names and passwords come on stdin so they never appear on a command line here.
set -eu

IFACE=wlan0
HOTSPOT=nfc-player-setup
SSID="NFC Player Setup"

hotspot_off() {
  nmcli connection down "$HOTSPOT" >/dev/null 2>&1 || true
  nmcli connection delete "$HOTSPOT" >/dev/null 2>&1 || true
}

case "${1:-}" in
  scan)
    nmcli -t -f SIGNAL,SECURITY,SSID device wifi list ifname "$IFACE" --rescan yes
    ;;
  hotspot-up)
    IFS= read -r PASS
    hotspot_off
    # Every security setting is spelled out rather than left to NetworkManager's hotspot defaults:
    # plain WPA2 with AES, and protected management frames off. With them on, the Pi's Wi-Fi chip
    # turns Macs and iPhones away as if the password were wrong.
    # autoconnect no: it never comes back on its own after a restart or power cut.
    nmcli connection add type wifi ifname "$IFACE" con-name "$HOTSPOT" autoconnect no ssid "$SSID" \
      802-11-wireless.mode ap 802-11-wireless.band bg \
      ipv4.method shared ipv6.method disabled \
      wifi-sec.key-mgmt wpa-psk wifi-sec.psk "$PASS" \
      wifi-sec.proto rsn wifi-sec.pairwise ccmp wifi-sec.group ccmp wifi-sec.pmf disable >/dev/null
    nmcli connection up "$HOTSPOT" >/dev/null
    ;;
  hotspot-down)
    hotspot_off
    nmcli device connect "$IFACE" >/dev/null 2>&1 || true
    ;;
  join)
    IFS= read -r NAME
    IFS= read -r PASS || PASS=""
    hotspot_off
    # The radio has been a hotspot: look around again before asking for the network by name.
    for _ in 1 2 3; do
      nmcli -t -f SSID device wifi list ifname "$IFACE" --rescan yes | grep -qxF -- "$NAME" && break
      sleep 2
    done
    if [ -n "$PASS" ]; then
      nmcli --wait 45 device wifi connect "$NAME" password "$PASS" ifname "$IFACE" >/dev/null
    else
      nmcli --wait 45 device wifi connect "$NAME" ifname "$IFACE" >/dev/null
    fi
    ;;
  radio-off)
    hotspot_off
    nmcli radio wifi off
    ;;
  radio-on)
    nmcli radio wifi on
    ;;
  *)
    echo "usage: $0 scan|hotspot-up|hotspot-down|join|radio-on|radio-off" >&2
    exit 2
    ;;
esac
